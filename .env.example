# Copia este archivo como .env y rellena tus propios valores.
# Nunca subas el archivo .env real (ya está en .gitignore).

# --- IA (obligatorio) ---
OPENAI_API_KEY=

# --- Visitas / Google Calendar (opcional) ---
# Si no se configuran, las visitas se siguen guardando en la base de
# datos, pero no se crea el evento en el calendario del comercial.
#
# 1. Crea una cuenta de servicio en Google Cloud Console con acceso a
#    la Calendar API y descarga su JSON de credenciales.
# 2. Comparte el calendario del comercial con el email de esa cuenta
#    de servicio (permiso "Realizar cambios en los eventos").
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_TIMEZONE=Europe/Madrid
COMERCIAL_EMAIL=

# --- Leads de Facebook / Instagram Lead Ads (opcional) ---
# 1. Configura un producto de Webhooks en tu app de Meta for Developers
#    apuntando a https://tu-dominio/webhooks/facebook
# 2. FACEBOOK_VERIFY_TOKEN debe coincidir con el token que introduzcas
#    en el panel de Meta al verificar el webhook.
# 3. FACEBOOK_PAGE_ACCESS_TOKEN es el token de la página de Facebook
#    asociada al formulario de anuncios.
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=
