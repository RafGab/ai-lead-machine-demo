# Copia este archivo como .env y rellena tus propios valores.
# Nunca subas el archivo .env real (ya está en .gitignore).

# --- IA (obligatorio) ---
OPENAI_API_KEY=

# --- Clave de administración para endpoints con datos personales
# (GET /study-leads, GET /reviews/pending, POST /reviews/{id}/publish) ---
ADMIN_KEY=

# --- Ruta del archivo de base de datos SQLite. En local puede quedar
# como está; en Render se apunta al disco persistente (ver render.yaml). ---
DATABASE_PATH=ai_lead_machine.db

# --- Visitas / Google Calendar (opcional) ---
# Si no se configuran, las visitas se siguen guardando en la base de
# datos, pero no se crea el evento en el calendario del comercial.
#
# 1. Crea una cuenta de servicio en Google Cloud Console con acceso a
#    la Calendar API y descarga su JSON de credenciales.
# 2. Comparte el calendario del comercial con el email de esa cuenta
#    de servicio (permiso "Realizar cambios en los eventos").
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_TIMEZONE=Europe/Madrid
COMERCIAL_EMAIL=

# Horario de atención (para saber cuándo SÍ se puede agendar, además de
# comprobar que el comercial esté libre). BUSINESS_DAYS usa lunes=0 ...
# domingo=6. Por defecto: lunes a viernes, 10:00 a 19:00.
BUSINESS_HOURS_START=10
BUSINESS_HOURS_END=19
BUSINESS_DAYS=0,1,2,3,4

# --- Calendario y horario propios de un rubro de la demo (opcional) ---
# Cada rubro de /demo (dental, despacho, hotel, gimnasio, extranjeria...)
# puede tener SU PROPIO calendario y horario, distinto del genérico de
# arriba, usando la misma cuenta de servicio: solo hay que compartir
# también ese calendario con su email. Ejemplo para Acero Pulido
# (vertical "extranjeria"):
# GOOGLE_CALENDAR_ID_EXTRANJERIA=
# COMERCIAL_EMAIL_EXTRANJERIA=
# BUSINESS_HOURS_START_EXTRANJERIA=
# BUSINESS_HOURS_END_EXTRANJERIA=
# BUSINESS_DAYS_EXTRANJERIA=
# Si no se define ninguna de estas variables para un rubro, se usan las
# genéricas de arriba.

# --- Aviso por correo cuando llega un lead (opcional) ---
# SMTP_USER: tu correo de Gmail que envía los avisos.
# SMTP_PASSWORD: una "contraseña de aplicación" de Google (no tu contraseña real).
# NOTIFY_EMAIL: a dónde llegan los avisos (si se omite, usa SMTP_USER).
# NOTIFY_EMAIL_<RUBRO>: correo propio de un rubro, p. ej. NOTIFY_EMAIL_EXTRANJERIA.
# NOTIFY_DEMO_LEADS=1: avisar también de las pruebas hechas dentro de la demo
# (por defecto solo avisan los leads reales que llegan desde el widget en la
# web de un cliente).
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=
# NOTIFY_EMAIL_EXTRANJERIA=
# NOTIFY_DEMO_LEADS=

# --- Leads de Facebook / Instagram Lead Ads (opcional) ---
# 1. Configura un producto de Webhooks en tu app de Meta for Developers
#    apuntando a https://tu-dominio/webhooks/facebook
# 2. FACEBOOK_VERIFY_TOKEN debe coincidir con el token que introduzcas
#    en el panel de Meta al verificar el webhook.
# 3. FACEBOOK_PAGE_ACCESS_TOKEN es el token de la página de Facebook
#    asociada al formulario de anuncios.
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=

# --- Pago de la primera consulta (solo vertical extranjería, ver
# examples/asesoria_extranjeria/) ---
# Clave secreta de tu cuenta de Stripe (sk_test_... para pruebas,
# sk_live_... en producción).
STRIPE_SECRET_KEY=
